# Copia este archivo a .env.local (git lo ignora) y llénalo con la config de tu
# app web de Firebase (Consola de Firebase › Configuración del proyecto › Tus apps).
VITE_FIREBASE_API_KEY=
# El dominio de Hosting donde se sirve la app (p. ej. mi-proyecto.web.app), no
# el .firebaseapp.com: así el login por redirección funciona en Safari/iOS.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Client ID del "Web client" de OAuth (Google Cloud › APIs y servicios ›
# Credenciales). Sin él, el respaldo se descarga al dispositivo en vez de ir a Drive.
VITE_GOOGLE_CLIENT_ID=
